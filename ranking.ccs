/* Estilos de la Tabla de puntuacion */

body {
  font-family: Arial, sans-serif;
  font-size: 16px;
  color: #1f2937;
  background-color: white;
}

h1 {
  color: #6a4c93;
}

table {
  border-collapse: collapse;
}

th, td {
  border: 2px solid #c8a2c8;
  padding: 12px;
}

th {
  background-color: #c8a2c8;
  color: #4b2e5c;
}

td {
  background-color: white;
}